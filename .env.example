# Copy to .env and edit. Loaded automatically by the backend (real environment variables win) and by docker compose.

# API key(s) for POST /generate, /jobs, /score, /connect/load (comma separated). If empty, an ephemeral key is printed at startup.
SDP_API_KEYS=change-me

# Optional: lets Claude refine schema guesses, text and chat edits (features still work without it).
# ANTHROPIC_API_KEY=
# SDP_LLM_MODEL=claude-haiku-4-5-20251001

# Every explicit generate/download is saved to History. Set to 0 to turn that off.
# SDP_AUTOSAVE=1

# Where job manifests, outputs and the LLM cache are stored (default: backend/data)
# SDP_DATA_DIR=./data

# Serve the built frontend from the API (Docker does this). Local dev uses the Vite server instead.
# SDP_STATIC_DIR=../frontend/dist

# Extra locale packs / document templates / starter packs (folders of JSON or template files)
# SDP_LOCALE_DIR=./locales
# SDP_TEMPLATE_DIR=
# SDP_PACK_DIR=

# Database loading. The UI route is off unless set to 1; the API route always needs the key.
# SDP_CONNECTORS_UI=1
# Hosts the server may connect to (localhost is always allowed)
# SDP_CONNECTOR_ALLOW_HOSTS=db.internal.example.com
# SDP_CONNECTOR_ALLOW_SQLITE_ANY=1
