{
  "name": "bank_customers",
  "description": "Retail bank customers with a monthly activity history and an optional fraud flag.",
  "keywords": ["bank customer", "bank customers", "bank account holder", "account holders", "banking customer", "bank clients", "bank client"],
  "table": "customers",
  "id_column": "customer_id",
  "identity": ["name", "phone", "national_id", "address", "date_of_birth"],
  "columns": [
    {"name": "account_type", "type": "category", "values": {"savings": 0.62, "current": 0.28, "business": 0.10}},
    {"name": "monthly_income", "type": "money", "median_key": "income_median", "sigma": 0.55},
    {"name": "account_balance", "type": "money", "median_key": "income_median", "median_multiple": 3.0, "sigma": 0.9,
     "corr_with": "monthly_income", "corr": 0.6},
    {"name": "account_open_date", "type": "date", "min_years_ago": 0, "max_years_ago": 15}
  ],
  "flag": {"name": "is_fraud", "keywords": ["fraud", "fraudulent", "fraudsters", "fraudster"], "default_rate": 0.02,
           "risk": {"account_balance": 0.4, "account_open_date": 0.5}},
  "history": {"table": "monthly_activity", "default_months": 12, "end_month": "2025-12-01",
              "count_base": 14.0, "ticket_fraction_of_income": 0.04, "spike_count_multiplier": [3.0, 6.0], "spike_ticket_multiplier": 4.0},
  "rules": [
    {"type": "unique", "column": "customer_id"},
    {"type": "not_null", "column": "name"},
    {"type": "range", "column": "monthly_income", "min": 0.01},
    {"type": "range", "column": "account_balance", "min": 0}
  ]
}
