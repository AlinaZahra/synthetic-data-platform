{
  "name": "purchase_order",
  "title": "Purchase order",
  "template": "template.html",
  "params": {"n_lines": {"default": 5, "min": 1, "max": 60}},
  "required": ["po_number", "buyer.name", "supplier.name", "order_date", "delivery_date", "total"],
  "build": [
    {"name": "buyer", "kind": "company", "suffixes": ["Group", "Holdings", "Corp"]},
    {"name": "supplier", "kind": "company", "suffixes": ["Supplies", "Wholesale", "Trading Co."]},
    {"name": "approver", "kind": "person"},
    {"name": "po_number", "kind": "id", "prefix": "PO-", "digits": 7},
    {"name": "order_date", "kind": "date", "start": "2025-01-01", "end": "2025-11-30"},
    {"name": "delivery_date", "kind": "expr", "type": "date", "expr": "date_add(order_date, randint(7, 30))"},
    {"name": "payment_terms", "kind": "choice", "values": ["Net 30", "Net 45", "Due on receipt"], "weights": [5, 3, 2]},
    {"name": "items", "kind": "group", "param": "n_lines", "count": [3, 10], "source": "catalog",
     "fields": {"quantity": {"kind": "int", "min": 1, "max": 50}},
     "row_computed": {"line_total": "round(quantity * unit_price)"},
     "types": {"quantity": "int", "unit_price": "money", "line_total": "money"}},
    {"name": "subtotal", "kind": "computed", "expr": "sum(items, 'line_total')"},
    {"name": "discount_pct", "kind": "choice", "type": "decimal", "values": ["0", "0.05", "0.10"], "weights": [5, 3, 2]},
    {"name": "discount", "kind": "computed", "expr": "pct(subtotal, discount_pct)"},
    {"name": "taxable", "kind": "computed", "expr": "subtotal - discount"},
    {"name": "tax", "kind": "computed", "expr": "pct(taxable, tax_rate)"},
    {"name": "shipping", "kind": "money", "min": 10, "max": 80},
    {"name": "total", "kind": "computed", "expr": "taxable + tax + shipping"}
  ],
  "rules": [
    {"name": "delivery is not before the order date", "expr": "delivery_date >= order_date"},
    {"name": "lines add up to the subtotal", "expr": "subtotal == sum(items, 'line_total')"},
    {"name": "taxable amount is subtotal minus discount", "expr": "taxable == subtotal - discount"},
    {"name": "total is taxable plus tax plus shipping", "expr": "total == taxable + tax + shipping"}
  ]
}
