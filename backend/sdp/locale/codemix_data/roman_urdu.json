  "locale": "ur-PK",
  "fillers": {"base": ["yaar", "bhai"], "en": ["actually", "basically", "sorry", "anyway"]},
  "topics": {
    "banking": {
      "lexicon": {
        "account": {"b": "khata", "e": "account"}, "block": {"b": "band", "e": "block"}, "please": {"b": "meharbani karke", "e": "please"},
