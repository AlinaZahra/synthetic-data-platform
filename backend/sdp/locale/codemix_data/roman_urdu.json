        "reset": {"b": "dobara set", "e": "reset"}, "agent": {"b": "numainda", "e": "agent"}, "ticket": {"b": "shikayat", "e": "ticket"},
        "service": {"b": "khidmat", "e": "service"}
      },
      "templates": [
        "{app} mein {login} ka {problem} hai, {please} {fix} karein",
        "Mujhe {password} {reset} karna hai",
        "Meri {ticket} par koi jawab nahi aya",
        "Mujhe {agent} se baat karni hai",
