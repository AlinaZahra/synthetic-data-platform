      "templates": [
        "Mujhe apne {order} ke baare mein poochna hai",
        "{product} mein masla hai, mujhe {refund} chahiye",
        "Kya main yeh {product} {return} kar sakta hoon?",
        "Mujhe {discount} chahiye is {product} par",
        "Mujhe {order} {cancel} karna hai",
        "{delivery} mein deri ho rahi hai, {please} jaldi karein",
        "Mujhe is {product} ki {price} ke baare mein batayein"
      ]
