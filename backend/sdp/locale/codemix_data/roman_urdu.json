        "transfer": {"b": "muntaqil", "e": "transfer"}, "amount": {"b": "raqam", "e": "amount"}, "statement": {"b": "bayan", "e": "statement"},
        "today": {"b": "aaj", "e": "today"}, "branch": {"b": "shaakh", "e": "branch"}
      },
      "templates": [
        "Mera {account} {block} ho gaya hai, {please} isay jaldi {fix} karein",
        "Mujhe {balance} {check} karna hai",
        "Mujhe {amount} {transfer} karna hai",
        "{account} mein masla hai, {please} madad karein",
        "Mujhe {today} {statement} chahiye",
        "{branch} kab khulti hai?"
      ]
    },
