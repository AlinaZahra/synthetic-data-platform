        "transfer": {"b": "sthanantar", "e": "transfer"}, "amount": {"b": "rashi", "e": "amount"}, "statement": {"b": "vivaran", "e": "statement"},
        "today": {"b": "aaj", "e": "today"}, "branch": {"b": "shakha", "e": "branch"}
      },
      "templates": [
        "Mera {account} {block} ho gaya hai, {please} ise jaldi {fix} karo",
        "Mujhe {balance} {check} karna hai",
        "Mujhe {amount} {transfer} karna hai",
