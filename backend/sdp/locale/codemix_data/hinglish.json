        "reset": {"b": "dobara set", "e": "reset"}, "agent": {"b": "pratinidhi", "e": "agent"}, "ticket": {"b": "shikayat", "e": "ticket"},
        "service": {"b": "seva", "e": "service"}
      },
      "templates": [
        "{app} mein {login} ki {problem} hai, {please} {fix} karo",
        "Mujhe {password} {reset} karna hai",
        "Meri {ticket} par koi jawab nahi aaya",
